# Copy to backend/.env and adjust. Never commit real secrets.
ENVIRONMENT=development
# Local default is SQLite at backend/impulse_dev.db (zero setup). For PostgreSQL:
# DATABASE_URL=postgresql+psycopg://impulse:impulse@localhost:5432/impulse
SECRET_KEY=change-me-to-a-long-random-string
FRONTEND_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
ENABLE_DEMO_LOGIN=true
RUN_BACKGROUND_JOBS=true
BACKGROUND_TICK_SECONDS=60
# LOCAL_STORAGE_DIR defaults to backend/private_storage
MAX_UPLOAD_MB=10

# --- Authentication: local | cognito ---
AUTH_PROVIDER=local
COGNITO_REGION=
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=
COGNITO_DOMAIN=
COGNITO_REDIRECT_URI=http://localhost:8000/api/auth/cognito/callback

# --- AWS (leave blank to use the documented local fallback) ---
AWS_REGION=ap-south-1
S3_DOCUMENTS_BUCKET=
KMS_KEY_ID=
DYNAMODB_EVENTS_TABLE=
DYNAMODB_IDEMPOTENCY_TABLE=
EVENTBRIDGE_BUS_NAME=
SFN_INTERACTION_STATE_MACHINE_ARN=
SNS_OPS_TOPIC_ARN=
SES_FROM_ADDRESS=
SMS_ORIGINATION_IDENTITY=
# Amazon SNS for patient/doctor SMS (see docs/AWS_SETUP_GUIDE.md step 4)
SNS_SMS_ENABLED=false
SNS_SMS_SENDER_ID=
SNS_DLT_ENTITY_ID=
SNS_DLT_TEMPLATE_ID=
# Amazon Bedrock AI drug-drug screening (labelled unverified; needs BEDROCK_MODEL_ID)
BEDROCK_INTERACTION_SCREENING=false
HEALTHLAKE_DATASTORE_ENDPOINT=
HEALTHLAKE_REGION=
COMPREHEND_MEDICAL_REGION=
BEDROCK_MODEL_ID=
BEDROCK_REGION=
APPSYNC_EVENTS_HTTP_ENDPOINT=
APPSYNC_EVENTS_API_KEY=
TIMESTREAM_INFLUX_URL=
TIMESTREAM_INFLUX_TOKEN=
LOCATION_PLACE_INDEX=
LOCATION_MAP_NAME=
LOCATION_API_KEY=
OPENSEARCH_ENDPOINT=

# --- Drug interaction knowledge source (licensed provider required) ---
INTERACTION_SOURCE=none
INTERACTION_SOURCE_URL=
INTERACTION_SOURCE_API_KEY=
INTERACTION_SOURCE_NAME=
